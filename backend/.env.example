# Database
DATABASE_URL="postgresql://licitai:licitai_dev_password@localhost:5432/licitai"

# JWT Authentication
JWT_SECRET="your-jwt-secret-at-least-32-characters-long"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-at-least-32-characters-long"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Claude API
CLAUDE_API_KEY="your-anthropic-claude-api-key-here"
CLAUDE_MODEL="claude-sonnet-4-20250514"

# Server
PORT=3001
NODE_ENV="development"

# CORS
FRONTEND_URL="http://localhost:5173"

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR="./uploads"

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
